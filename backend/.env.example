# FIDES backend — example environment configuration
# Copy this file to `.env` for local development. Never commit a real `.env`.
# No real secrets are present in this file.

# Application environment: local | development | test | staging | production
APP_ENV=local

# Human-readable service name (used in logs and health responses)
APP_NAME=fides-backend

# Logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# HTTP port the service listens on (used by local uvicorn invocation)
PORT=8000

# --- Database (B1) ---
# Development database. Matches docker-compose.yml's `db` service.
# Host port is 5433 (mapped to the container's internal 5432) — see
# docker-compose.yml for why the host port differs from Postgres' default.
# No real credentials here — these are local-only defaults for the
# Docker Compose Postgres container, not a production secret.
DATABASE_URL=postgresql+psycopg://fides:fides_local_dev_only@localhost:5433/fides_dev

# Dedicated, isolated test database. Never the same database as
# DATABASE_URL above. Used only by the automated test suite.
TEST_DATABASE_URL=postgresql+psycopg://fides:fides_local_dev_only@localhost:5433/fides_test

# --- Authentication foundation (B2-D2) ---
# disabled | fake | twilio. No network/provider behavior is implemented in B2-A.
# Local/test may use disabled without secrets. Staging/production require twilio.
# An enabled provider requires a separately generated HMAC secret, even in tests.
OTP_PROVIDER=disabled
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_SESSION_TTL_SECONDS=2592000
OTP_CODE_LENGTH=6
OTP_CHALLENGE_TTL_SECONDS=600
OTP_PROVIDER_OPERATION_LEASE_SECONDS=30
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_REQUEST_PHONE_10M_LIMIT=3
OTP_REQUEST_PHONE_24H_LIMIT=10
OTP_REQUEST_IP_10M_LIMIT=20
OTP_REQUEST_IP_24H_LIMIT=100
OTP_VERIFY_CHALLENGE_LIMIT=5
OTP_VERIFY_PHONE_10M_LIMIT=10
OTP_VERIFY_IP_1M_LIMIT=30
OTP_VERIFY_IP_1H_LIMIT=200
AUTH_REFRESH_SESSION_1M_LIMIT=10
AUTH_REFRESH_IP_1M_LIMIT=60
# JSON CIDR list; empty means use only the actual connection peer.
# Run Uvicorn with --no-proxy-headers so it does not rewrite the peer first.
# Only explicitly trusted proxy peers may supply X-Forwarded-For to Fides.
AUTH_TRUSTED_PROXY_CIDRS=[]

# Supply credentials via environment/secret manager; never check real values in.
# API Key SID: SK + 32 hex characters. Service SIDs: VA + 32 hex characters.
# Signup/login Service SIDs must be distinct. No master Account Auth Token.
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_VERIFY_SIGNUP_SERVICE_SID=
TWILIO_VERIFY_LOGIN_SERVICE_SID=
AUTH_RATE_LIMIT_HMAC_SECRET=

OTP_PROVIDER_CONNECT_TIMEOUT_SECONDS=2
OTP_PROVIDER_READ_TIMEOUT_SECONDS=5
OTP_PROVIDER_WRITE_TIMEOUT_SECONDS=5
OTP_PROVIDER_POOL_TIMEOUT_SECONDS=1
OTP_PROVIDER_OPERATION_BUDGET_SECONDS=10
# Delays measured AFTER the respective expiry, not from row creation.
AUTH_OTP_CLEANUP_RETENTION_SECONDS=86400
AUTH_RATE_LIMIT_CLEANUP_RETENTION_SECONDS=86400
AUTH_SESSION_CLEANUP_RETENTION_SECONDS=2592000
