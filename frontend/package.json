{
  "name": "fides-frontend",
  "private": true,
  "workspaces": [
    "shared",
    "web",
    "mobile"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "web": "npm run dev --workspace=@fides/web",
    "mobile": "npm run start --workspace=@fides/mobile",
    "lint": "eslint web mobile shared",
    "typecheck": "npm run typecheck --workspaces",
    "build:web": "npm run build --workspace=@fides/web",
    "test:auth": "node --test tests/auth.test.cjs",
    "preview:auth": "node tests/auth-preview.cjs",
    "test:connections": "node --test tests/connections.test.cjs",
    "test:connections:live": "node tests/connections-live.cjs",
    "preview:connections": "node tests/connections-preview.cjs",
    "test:commitments": "node --test tests/commitments.test.cjs",
    "test:commitments:live": "node tests/commitments-live.cjs",
    "preview:commitments": "node tests/commitments-preview.cjs",
    "test:repayments": "node --test tests/repayments.test.cjs",
    "test:repayments:live": "node tests/repayments-live.cjs",
    "preview:repayments": "node tests/repayments-preview.cjs",
    "test:dashboard": "node --test tests/dashboard.test.cjs",
    "test:dashboard:live": "node tests/dashboard-live.cjs",
    "preview:dashboard": "node tests/dashboard-preview.cjs"
  },
  "devDependencies": {
    "typescript": "~6.0.3"
  }
}
